# ChainTruth — Environment Variables
# Copy to .env and fill in values. Never commit the .env file.

# Option A: Named connection (if ~/.snowflake/connections.toml is configured)
# SNOWFLAKE_CONNECTION_NAME=HA10998

# Option B: Explicit credentials (for Render, Docker, CI, etc.)
SNOWFLAKE_ACCOUNT=your_account.region
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=CHAINTRUTH_WH
SNOWFLAKE_DATABASE=CHAINTRUTH_DB
SNOWFLAKE_ROLE=SYSADMIN
